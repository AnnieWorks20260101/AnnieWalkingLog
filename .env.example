# このファイルを .env にコピーし、実際のキーを入れてください（.env は Git に含めません）

# OpenWeatherMap（https://openweathermap.org/api）
OPENWEATHER_API_KEY=

# Google Maps Platform（react-native-maps）
# Google Cloud Console で Maps SDK for Android / iOS を有効化し、アプリ制限をかけたキー
GOOGLE_MAPS_API_KEY_Android=
GOOGLE_MAPS_API_KEY_iOS=

# Firebase Google Sign-In（@react-native-google-signin/google-signin）
# Firebase Console → プロジェクトの設定 → 全般 → Web クライアント ID
# （google-services.json の oauth_client で client_type: 3 の client_id と同じ）
# Maps 用 API キーとは別物です。手順: docs/GOOGLE_SIGN_IN.md
GOOGLE_WEB_CLIENT_ID=
