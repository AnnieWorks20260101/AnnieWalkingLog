{
  "expo": {
    "name": "AnnieWalkingLog",
    "slug": "AnnieWalkingLog",
    "version": "0.91.06",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.annieworks.AnnieWalkingLog",
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "appleTeamId": "8AXQGJTA55",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.annieworks.AnnieWalkingLog.walk"
        ],
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "ja",
        "CFBundleLocalizations": [
          "ja",
          "en"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "お散歩の記録のためにカメラを使用します。",
        "NSPhotoLibraryUsageDescription": "お散歩の写真をフォトに保存するために使用します。",
        "NSPhotoLibraryAddUsageDescription": "お散歩の写真をフォトアルバムに保存します。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "package": "com.annieworks.AnnieWalkingLog",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "CAMERA",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "7718817f-9965-453a-a6a4-4b5b6223a22e"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "ペットのお散歩ルートを記録するために位置情報を使用します。",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "お散歩の記録のためにカメラを使用します。"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "お散歩の写真をフォトに保存するために使用します。",
          "savePhotosPermission": "お散歩の写真をフォトアルバムに保存します。"
        }
      ],
      "./modules/expo-walk-tracking/app.plugin.js",
      "./plugins/withGoogleModularHeaders.js",
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.2"
          }
        }
      ]
    ]
  }
}
